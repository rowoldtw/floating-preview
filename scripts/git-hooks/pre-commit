#!/bin/sh
# Regenerates ROADMAP.md and the features' synced properties (bun run roadmap),
# and stages what it rewrote plus ROADMAP.md, so a commit never leaves it
# stale (even when it was regenerated by hand and left unstaged).
# Installed by `bun install` (package.json "prepare" sets core.hooksPath).
files=$(bun scripts/roadmap.ts) || exit 1
printf '%s\n' "$files" ROADMAP.md | while IFS= read -r file; do
  [ -n "$file" ] && git add -- "$file"
done
